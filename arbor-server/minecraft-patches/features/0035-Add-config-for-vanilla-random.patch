+    public final RandomSource random = zone.little.arbor.config.modules.fixes.VanillaRandomSourceConfig.useLegacyRandomSourceForPlayers ? RandomSource.create() : SHARED_RANDOM; // Paper - Share random for entities to make them more random // Arbor - Add config for vanilla random SHARED_RANDOM
