diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index 5bc51fa6d7bda19fdac067200c3e0ab503663166..06a101aa219f8c796c6a0d2eef8098a95fb97b2e 100644
--- a/net/minecraft/world/entity/Mob.java
+++ b/net/minecraft/world/entity/Mob.java
@@ -829,11 +829,12 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
             return;
         }
         // Paper end - Allow nerfed mobs to jump and float
+        int idBasedTickCount = this.tickCount + this.getId(); // Arbor - Petal - Move up
         ProfilerFiller profiler = Profiler.get();
         profiler.push("sensing");
-        this.sensing.tick();
+        if (idBasedTickCount % zone.little.arbor.config.modules.optimizations.PetalReduceSensorWorkConfig.delayTicks == 0 || !zone.little.arbor.config.modules.optimizations.PetalReduceSensorWorkConfig.enabled) this.sensing.tick(); // Arbor - Petal - Reduce sensor work
         profiler.pop();
-        int idBasedTickCount = this.tickCount + this.getId();
+        //int idBasedTickCount = this.tickCount + this.getId(); // Arbor - Petal - Move up
         if (idBasedTickCount % 2 != 0 && this.tickCount > 1) {
             profiler.push("targetSelector");
             this.targetSelector.tickRunningGoals(false);
