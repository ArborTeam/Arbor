diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index c5bf270e83d0b30ad407bcf0d2c38fe1a6c869bc..e53f55932930fe817ac64f6c321e378dd181096c 100755
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2501,11 +2501,14 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         Optional<Holder<PoiType>> newType = PoiTypes.forState(newState);
         if (!Objects.equals(oldType, newType)) {
             BlockPos immutable = pos.immutable();
-            oldType.ifPresent(poiType -> io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueChunkTask(this, immutable.getX() >> 4, immutable.getZ() >> 4, () -> { // Folia - region threading
+            final java.util.concurrent.Executor scheduler = this.regionizedBlockableEventLoop.asExecutor(pos, true); // Luminol - Instant POI updates
+            //oldType.ifPresent(poiType -> io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueChunkTask(this, immutable.getX() >> 4, immutable.getZ() >> 4, () -> { // Folia - region threading  // Luminol - Instant POI updates
+            oldType.ifPresent(poiType -> scheduler.execute(() -> {  // Luminol - Instant POI updates
                 this.getPoiManager().remove(immutable);
                 this.debugSynchronizers.dropPoi(immutable);
             }));
-            newType.ifPresent(poiType -> io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueChunkTask(this, immutable.getX() >> 4, immutable.getZ() >> 4, () -> { // Folia - region threading
+            //newType.ifPresent(poiType -> io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueChunkTask(this, immutable.getX() >> 4, immutable.getZ() >> 4, () -> { // Folia - region threading // Luminol - Instant POI updates
+            newType.ifPresent(poiType -> scheduler.execute(() -> { // Luminol - Instant POI updates
                 // Paper start - Remove stale POIs
                 if (oldType.isEmpty() && this.getPoiManager().exists(immutable, ignored -> true)) {
                     this.getPoiManager().remove(immutable);
