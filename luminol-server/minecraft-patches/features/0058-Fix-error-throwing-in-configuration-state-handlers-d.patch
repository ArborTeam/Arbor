From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MrHua269 <mrhua269@gmail.com>
Date: Wed, 2 Jul 2025 22:39:21 +0800
Subject: [PATCH] Fix error throwing in configuration state handlers
 disconnecting logics

A possible fix for https://github.com/PaperMC/Folia/issues/378
Should be a new way to gracefully and more correctly retire the entity scheduler of players

diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index 31101f5af05772a0842b56ecc2dd8c79eebee933..27da5bbc6572e3c0b2eccfe69ee6e66e58a44c9d 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -83,6 +83,11 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
     private boolean handledDisconnect = false;
     // Folia end - region threading
 
+    // Luminol start - Fix error throwing in configuration state handlers disconnecting logics
+    @Nullable
+    protected net.minecraft.server.level.ServerPlayer lastInGamePlayer = null; // Ugly but working hack()
+    // Luminol end
+
     @Override
     public void onDisconnect(DisconnectionDetails details) {
         // Folia start - region threading
@@ -98,6 +103,22 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
         }
         // Folia start - region threading
         if (!(this instanceof ServerGamePacketListenerImpl gamePacketListener)) {
+            // Luminol start - Fix error throwing in configuration state handlers disconnecting logics
+            // we are not starting to turn into a game packet handler, so we can safely return
+            if (this instanceof ServerConfigurationPacketListenerImpl && !io.papermc.paper.threadedregions.RegionizedServer.isNotOwnedByGlobalRegion(this.connection)) {
+                // folia's weird entity scheduler process?
+                // however, we still need to retire it eventually
+                if (this.lastInGamePlayer != null) {
+                    io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(
+                            this.lastInGamePlayer.level(),
+                            this.lastInGamePlayer.getBlockX() >> 4,
+                            this.lastInGamePlayer.getBlockZ() >> 4,
+                            () -> this.lastInGamePlayer.getBukkitEntity().taskScheduler.retire());
+                    this.lastInGamePlayer = null; // release reference
+                }
+                return;
+            }
+            // Luminol end
             throw new UnsupportedOperationException("Configuration mode is not supported in its current state");
         }
         gamePacketListener.player.getBukkitEntity().taskScheduler.retire();
@@ -356,14 +377,25 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
             return;
         }
         // Folia start - region threading
-        if (!(this instanceof ServerGamePacketListenerImpl gamePacketListener)) {
-            throw new UnsupportedOperationException("Configuration mode is not supported in its current state");
+        if (this instanceof ServerGamePacketListenerImpl gamePacketListener) {
+            // Luminol start - Fix error throwing in configuration state handlers disconnecting logics
+            // folia's weird entity scheduler process?
+            // we'll retire soonly
+            //throw new UnsupportedOperationException("Configuration mode is not supported in its current state");
+            if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(gamePacketListener.player)) { // Folia - region threading
+                this.connection.disconnectSafely(disconnectionDetails); // Folia - region threading - it HAS to be delayed/async to avoid deadlock if we try to wait for another region
+                return;
+            }
+        }else {
+            // disconnecting configuration handler off globalregion
+            if (!io.papermc.paper.threadedregions.RegionizedServer.isGlobalTickThread()) {
+                // calling on configuration mode
+                this.connection.disconnectSafely(disconnectionDetails); // Folia - region threading - it HAS to be delayed/async to avoid deadlock if we try to wait for another region
+                return;
+            }
         }
         // Folia end - region threading
-        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(gamePacketListener.player)) { // Folia - region threading
-            this.connection.disconnectSafely(disconnectionDetails); // Folia - region threading - it HAS to be delayed/async to avoid deadlock if we try to wait for another region
-            return;
-        }
+        // Luminol end
 
         Component reason;
         Component leaveMessage;
diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index e87d6a5e0fe2789ab2518a2b3558e7c0c2320feb..600e7a716b94102714ed2681e52a42a6d7198fac 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -3674,6 +3674,7 @@ public class ServerGamePacketListenerImpl
             throw new IllegalStateException("Client acknowledged config, but none was requested");
         } else {
             final ServerConfigurationPacketListenerImpl listener = new ServerConfigurationPacketListenerImpl(this.server, this.connection, this.createCookie(this.player.clientInformation())); // Paper
+            listener.lastInGamePlayer = this.player; // Luminol - Fix error throwing in configuration state handlers disconnecting logics // Ugly but working hack()
             this.connection
                 .setupInboundProtocol(
                     ConfigurationProtocols.SERVERBOUND,
