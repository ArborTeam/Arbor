         this.randomWalk();
          */
         ++this.tickCount;
+        // Luminol start - Add a config to enable tick command
+        if (me.earthme.luminol.config.modules.experiment.CommandTickConfig.enabled) {
+            MinecraftServer.tickRateManager.tick();
+        }
