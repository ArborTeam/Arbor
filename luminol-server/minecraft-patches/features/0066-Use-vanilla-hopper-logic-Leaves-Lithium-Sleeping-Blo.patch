+    // Leaves start - Lithium Sleeping Block Entity
+    public void notifyTrackersIfNeed() {
+        if (!me.earthme.luminol.config.modules.optimizations.LeavesSleepingBlockEntityConfig.enabled) return;
+
+        var currRegionizedWorldData = io.papermc.paper.threadedregions.TickRegionScheduler.getCurrentRegionizedWorldData();
+        // no world data
+        if (currRegionizedWorldData == null) return;
+
+        // has world data but not matched
+        if (currRegionizedWorldData.world != this.level) return;
+
+        if (this instanceof ItemEntity) {
+            long sectionKey = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionKey(this);
+
+            var tracker = currRegionizedWorldData.itemEntityMovementTrackerMap.computeIfAbsent(
+                    sectionKey,
+                    k -> new org.leavesmc.leaves.lithium.common.tracking.entity.ChunkSectionItemEntityMovementTracker(sectionKey, this.level)
+            );
+
+            tracker.notifyAllListeners(currRegionizedWorldData.getRedstoneGameTime());
+            return;
+        }
+
+        if (this instanceof net.minecraft.world.entity.vehicle.ContainerEntity) {
+            long sectionKey = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionKey(this);
+            var tracker = currRegionizedWorldData.containerEntityMovementTrackerMap.computeIfAbsent(
+                    sectionKey,
+                    k -> new org.leavesmc.leaves.lithium.common.tracking.entity.ChunkSectionInventoryEntityTracker(sectionKey, this.level)
+            );
+            tracker.notifyAllListeners(currRegionizedWorldData.getRedstoneGameTime());
+        }
+    }
+    // Leaves end - Lithium Sleeping Block Entity
 
     public void checkDespawn() {
     }
