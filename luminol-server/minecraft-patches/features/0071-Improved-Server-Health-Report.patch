+        // Luminol start - improve server health report
+        // Memory information
+        final MemoryMXBean memoryBean = ManagementFactory.getMemoryMXBean();
+        final MemoryUsage heapUsage = memoryBean.getHeapMemoryUsage();
+        final long usedMemory = heapUsage.getUsed() / (1024 * 1024); // MB
+        final long maxMemory = heapUsage.getMax() / (1024 * 1024); // MB
+        final long freeMemory = maxMemory - usedMemory;
+        // Luminol end - improve server health report
+
         for (final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region : regions) {
             final TickData.TickReportData report = region.getData().getRegionSchedulingHandle().getTickReport15s(currTime);
