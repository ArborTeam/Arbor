From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Libalpm64 <libalpm@proton.me>
Date: Mon, 02 Mar 2026 00:00:00 +0000
Subject: [PATCH] Luminol: Add secure seed V2 with Blake3

diff --git a/net/minecraft/world/level/levelgen/RandomState.java b/net/minecraft/world/level/levelgen/RandomState.java
--- a/net/minecraft/world/level/levelgen/RandomState.java
+++ b/net/minecraft/world/level/levelgen/RandomState.java
@@ -12,6 +12,10 @@ import net.minecraft.util.RandomSource;
 import net.minecraft.world.level.biome.Climate;
 import net.minecraft.world.level.levelgen.synth.BlendedNoise;
 import net.minecraft.world.level.levelgen.synth.NormalNoise;
+import su.plo.matter.Globals;
+import su.plo.matter.WorldgenCryptoRandom;
+import su.plo.matter.HashingV2;
+import me.earthme.luminol.config.modules.function.SecureSeedConfig;
 
 public final class RandomState {
     final PositionalRandomFactory random;
@@ -35,10 +39,24 @@ public final class RandomState {
     }
 
     private RandomState(NoiseGeneratorSettings settings, HolderGetter<NormalNoise.NoiseParameters> noiseParametersGetter, final long levelSeed) {
-        this.random = settings.getRandomSource().newInstance(levelSeed).forkPositional();
+        final long[] secureWorldSeed = (SecureSeedConfig.enabled && SecureSeedConfig.version == 2)
+            ? HashingV2.expandLevelSeedTo1024Bits(levelSeed)
+            : null;
+
+        long terrainSeed = (SecureSeedConfig.enabled && SecureSeedConfig.version == 2)
+            ? HashingV2.getTerrainSeed(secureWorldSeed, HashingV2.TerrainType.BASE_TERRAIN)
+            : levelSeed;
+        long aquiferSeed = (SecureSeedConfig.enabled && SecureSeedConfig.version == 2)
+            ? HashingV2.getTerrainSeed(secureWorldSeed, HashingV2.TerrainType.AQUIFER)
+            : levelSeed;
+        long oreSeed = (SecureSeedConfig.enabled && SecureSeedConfig.version == 2)
+            ? HashingV2.getTerrainSeed(secureWorldSeed, HashingV2.TerrainType.ORE)
+            : levelSeed;
+
+        this.random = settings.getRandomSource().newInstance(terrainSeed).forkPositional();
         this.noises = noiseParametersGetter;
-        this.aquiferRandom = this.random.fromHashOf(Identifier.withDefaultNamespace("aquifer")).forkPositional();
-        this.oreRandom = this.random.fromHashOf(Identifier.withDefaultNamespace("ore")).forkPositional();
+        this.aquiferRandom = settings.getRandomSource().newInstance(aquiferSeed).forkPositional();
+        this.oreRandom = settings.getRandomSource().newInstance(oreSeed).forkPositional();
         this.noiseIntances = new ConcurrentHashMap<>();
         this.positionalRandoms = new ConcurrentHashMap<>();
         this.surfaceSystem = new SurfaceSystem(this, settings.defaultBlock(), settings.seaLevel(), this.random);
@@ -48,6 +66,10 @@ public final class RandomState {
             private final Map<DensityFunction, DensityFunction> wrapped = new HashMap<>();
 
             private RandomSource newLegacyInstance(long seed) {
+                if (SecureSeedConfig.enabled && SecureSeedConfig.version == 2) {
+                    long climateSeed = HashingV2.getTerrainSeed(secureWorldSeed, HashingV2.TerrainType.CLIMATE);
+                    return new WorldgenCryptoRandom(0, 0, Globals.Salt.UNDEFINED, climateSeed + seed);
+                }
                 return new LegacyRandomSource(levelSeed + seed);
             }
 
@@ -85,7 +107,9 @@ public final class RandomState {
                     return blendedNoise.withNewRandom(randomSource);
                 } else {
                     return (DensityFunction)(densityFunction instanceof DensityFunctions.EndIslandDensityFunction
-                        ? new DensityFunctions.EndIslandDensityFunction(levelSeed)
+                        ? new DensityFunctions.EndIslandDensityFunction((SecureSeedConfig.enabled && SecureSeedConfig.version == 2)
+                            ? HashingV2.getTerrainSeed(secureWorldSeed, HashingV2.TerrainType.SURFACE)
+                            : levelSeed)
                         : densityFunction);
                 }
             }
